# ──────────────────────────────────────────────────────────────
# Lidarr Hits Bot — Environment Variables
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Enable "Message Content Intent" under Bot > Privileged Gateway Intents
DISCORD_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=?
# Channel ID for daily reports (right-click channel > Copy ID)
# Set to 0 to skip posting reports (logs only)
REPORT_CHANNEL_ID=0

# ── Spotify ───────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Use "Client Credentials" flow (no user login needed)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Minimum popularity (0-100) to consider a track "popular"
# 60 = moderate hits, 70 = solid hits, 80 = big hits only
POPULARITY_THRESHOLD=60

# ── Lidarr ────────────────────────────────────────────────────
# URL where Lidarr is accessible from this container
# If Lidarr is in Docker on the same machine:
#   LIDARR_URL=http://host.docker.internal:8686
# If Lidarr is on the host network:
#   LIDARR_URL=http://192.168.x.x:8686
LIDARR_URL=http://host.docker.internal:8686
# Found in Lidarr > Settings > General > API Key
LIDARR_API_KEY=your_lidarr_api_key_here
# Quality profile to use for new artists (must match Lidarr exactly)
LIDARR_QUALITY_PROFILE=Standard
# Root folder in Lidarr for music storage
LIDARR_ROOT_FOLDER=/music
# Download mode: "tracks" = only popular tracks (default), "album" = whole album
DOWNLOAD_MODE=tracks

# ── Scheduler ─────────────────────────────────────────────────
# Cron expression for daily check (default: every day at 9 AM)
DAILY_CHECK_CRON=0 9 * * *
# Your timezone (used for cron scheduling)
TIMEZONE=America/Detroit
